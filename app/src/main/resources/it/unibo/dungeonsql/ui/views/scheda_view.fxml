<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<fx:root type="ScrollPane"
         fitToWidth="true"
         fitToHeight="false"
         hbarPolicy="NEVER"
         style="-fx-background-color: #d9d0bd; -fx-border-width: 0;"
         xmlns="http://javafx.com/javafx/21"
         xmlns:fx="http://javafx.com/fxml/1">
    <content>
        <VBox alignment="TOP_CENTER" spacing="12.0"
              style="-fx-background-color: #d9d0bd; -fx-padding: 16 18 22 18;">

            <!-- ===================== HEADER ===================== -->
            <VBox spacing="8.0" maxWidth="1400.0"
                  style="-fx-background-color: #f4efe4; -fx-border-color: #6d1f1f; -fx-border-width: 2; -fx-padding: 12 14 12 14;">
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <VBox HBox.hgrow="ALWAYS" spacing="2.0">
                        <Label text="NOME DEL PERSONAGGIO"
                               style="-fx-text-fill: #6d1f1f; -fx-font-size: 10px; -fx-font-weight: bold;"/>
                        <Label fx:id="characterNameLabel" text="Nome Personaggio"
                               style="-fx-text-fill: #241b15; -fx-font-family: 'Georgia'; -fx-font-size: 26px; -fx-font-weight: bold;"
                               wrapText="true"/>
                    </VBox>
                    <VBox prefWidth="145.0" spacing="2.0">
                        <Label text="BACKGROUND" style="-fx-text-fill: #6d1f1f; -fx-font-size: 9px; -fx-font-weight: bold;"/>
                        <Label fx:id="backgroundLabel" text="—"
                               style="-fx-text-fill: #241b15; -fx-font-size: 13px; -fx-font-weight: bold;"
                               wrapText="true"/>
                    </VBox>
                    <VBox prefWidth="145.0" spacing="2.0">
                        <Label text="GIOCATORE" style="-fx-text-fill: #6d1f1f; -fx-font-size: 9px; -fx-font-weight: bold;"/>
                        <Label fx:id="creatorLabel" text="—"
                               style="-fx-text-fill: #241b15; -fx-font-size: 13px; -fx-font-weight: bold;"
                               wrapText="true"/>
                    </VBox>
                    <VBox prefWidth="125.0" spacing="2.0">
                        <Label text="RAZZA" style="-fx-text-fill: #6d1f1f; -fx-font-size: 9px; -fx-font-weight: bold;"/>
                        <Label fx:id="raceLabel" text="—"
                               style="-fx-text-fill: #241b15; -fx-font-size: 13px; -fx-font-weight: bold;"
                               wrapText="true"/>
                    </VBox>
                    <VBox prefWidth="135.0" spacing="2.0">
                        <Label text="ALLINEAMENTO" style="-fx-text-fill: #6d1f1f; -fx-font-size: 9px; -fx-font-weight: bold;"/>
                        <Label fx:id="alignmentLabel" text="—"
                               style="-fx-text-fill: #241b15; -fx-font-size: 13px; -fx-font-weight: bold;"
                               wrapText="true"/>
                    </VBox>
                    <VBox prefWidth="100.0" spacing="2.0" alignment="CENTER">
                        <Label text="ESPERIENZA" style="-fx-text-fill: #6d1f1f; -fx-font-size: 9px; -fx-font-weight: bold;"/>
                        <Label fx:id="experienceLabel" text="0"
                               style="-fx-text-fill: #241b15; -fx-font-size: 16px; -fx-font-weight: bold;"/>
                    </VBox>
                </HBox>
            </VBox>

            <!-- ===================== MAIN SHEET ===================== -->
            <GridPane maxWidth="1400.0" hgap="10.0" vgap="10.0"
                      style="-fx-background-color: transparent;">
                <padding>
                    <Insets top="0" right="0" bottom="0" left="0"/>
                </padding>

                <!-- ===================== LEFT COLUMN ===================== -->
                <VBox GridPane.columnIndex="0" GridPane.rowIndex="0" spacing="10.0">

                    <!-- Characteristics -->
                    <VBox spacing="7.0"
                          style="-fx-background-color: #f4efe4; -fx-border-color: #6d1f1f; -fx-border-width: 1.5; -fx-padding: 9 9 9 9;">
                        <Label text="CARATTERISTICHE"
                               style="-fx-background-color: #6d1f1f; -fx-text-fill: #f8f2e6; -fx-font-family: 'Georgia'; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 5 7 5 7;"/>

                        <GridPane hgap="4.0" vgap="4.0">
                            <columnConstraints>
                                <ColumnConstraints minWidth="40.0" prefWidth="42.0" halignment="CENTER"/>
                                <ColumnConstraints minWidth="108.0" prefWidth="120.0" hgrow="ALWAYS"/>
                                <ColumnConstraints minWidth="42.0" prefWidth="44.0" halignment="CENTER"/>
                                <ColumnConstraints minWidth="42.0" prefWidth="44.0" halignment="CENTER"/>
                            </columnConstraints>

                            <Label text="MOD" GridPane.columnIndex="0" style="-fx-text-fill: #6d1f1f; -fx-font-size: 9px; -fx-font-weight: bold;"/>
                            <Label text="CARATTERISTICA" GridPane.columnIndex="1" style="-fx-text-fill: #6d1f1f; -fx-font-size: 9px; -fx-font-weight: bold;"/>
                            <Label text="VAL." GridPane.columnIndex="2" style="-fx-text-fill: #6d1f1f; -fx-font-size: 9px; -fx-font-weight: bold;"/>
                            <Label text="T.S." GridPane.columnIndex="3" style="-fx-text-fill: #6d1f1f; -fx-font-size: 9px; -fx-font-weight: bold;"/>
                            <Label fx:id="strengthNameLabel" text="Forza" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                            <Label fx:id="strengthScoreLabel" text="10" GridPane.columnIndex="2" GridPane.rowIndex="1" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                            <Label fx:id="strengthModifierLabel" text="+0" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-font-size: 13px; -fx-font-weight: bold;"/>
                            <Label fx:id="strengthSavingLabel" text="+0" GridPane.columnIndex="3" GridPane.rowIndex="1"/>
                            <Label fx:id="dexterityNameLabel" text="Destrezza" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                            <Label fx:id="dexterityScoreLabel" text="10" GridPane.columnIndex="2" GridPane.rowIndex="2" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                            <Label fx:id="dexterityModifierLabel" text="+0" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-font-size: 13px; -fx-font-weight: bold;"/>
                            <Label fx:id="dexteritySavingLabel" text="+0" GridPane.columnIndex="3" GridPane.rowIndex="2"/>
                            <Label fx:id="constitutionNameLabel" text="Costituzione" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                            <Label fx:id="constitutionScoreLabel" text="10" GridPane.columnIndex="2" GridPane.rowIndex="3" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                            <Label fx:id="constitutionModifierLabel" text="+0" GridPane.columnIndex="0" GridPane.rowIndex="3" style="-fx-font-size: 13px; -fx-font-weight: bold;"/>
                            <Label fx:id="constitutionSavingLabel" text="+0" GridPane.columnIndex="3" GridPane.rowIndex="3"/>
                            <Label fx:id="intelligenceNameLabel" text="Intelligenza" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                            <Label fx:id="intelligenceScoreLabel" text="10" GridPane.columnIndex="2" GridPane.rowIndex="4" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                            <Label fx:id="intelligenceModifierLabel" text="+0" GridPane.columnIndex="0" GridPane.rowIndex="4" style="-fx-font-size: 13px; -fx-font-weight: bold;"/>
                            <Label fx:id="intelligenceSavingLabel" text="+0" GridPane.columnIndex="3" GridPane.rowIndex="4"/>
                            <Label fx:id="wisdomNameLabel" text="Saggezza" GridPane.columnIndex="1" GridPane.rowIndex="5"/>
                            <Label fx:id="wisdomScoreLabel" text="10" GridPane.columnIndex="2" GridPane.rowIndex="5" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                            <Label fx:id="wisdomModifierLabel" text="+0" GridPane.columnIndex="0" GridPane.rowIndex="5" style="-fx-font-size: 13px; -fx-font-weight: bold;"/>
                            <Label fx:id="wisdomSavingLabel" text="+0" GridPane.columnIndex="3" GridPane.rowIndex="5"/>
                            <Label fx:id="charismaNameLabel" text="Carisma" GridPane.columnIndex="1" GridPane.rowIndex="6"/>
                            <Label fx:id="charismaScoreLabel" text="10" GridPane.columnIndex="2" GridPane.rowIndex="6" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                            <Label fx:id="charismaModifierLabel" text="+0" GridPane.columnIndex="0" GridPane.rowIndex="6" style="-fx-font-size: 13px; -fx-font-weight: bold;"/>
                            <Label fx:id="charismaSavingLabel" text="+0" GridPane.columnIndex="3" GridPane.rowIndex="6"/>
                        </GridPane>

                        <HBox spacing="7.0" alignment="CENTER_LEFT"
                              style="-fx-border-color: #a59178; -fx-border-width: 1 0 0 0; -fx-padding: 6 0 0 0;">
                            <Label text="BONUS COMPETENZA" style="-fx-text-fill: #6d1f1f; -fx-font-size: 9px; -fx-font-weight: bold;"/>
                            <Label fx:id="proficiencyBonusLabel" text="+2" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                        </HBox>
                    </VBox>

                    <!-- Skills -->
                    <VBox spacing="5.0"
                          style="-fx-background-color: #f4efe4; -fx-border-color: #6d1f1f; -fx-border-width: 1.5; -fx-padding: 9 9 9 9;">
                        <Label text="ABILITÀ"
                               style="-fx-background-color: #6d1f1f; -fx-text-fill: #f8f2e6; -fx-font-family: 'Georgia'; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 5 7 5 7;"/>
                        <Label text="Cerchio = competenza" wrapText="true"
                               style="-fx-text-fill: #65584b; -fx-font-size: 9px; -fx-font-style: italic;"/>

                        <GridPane hgap="5.0" vgap="3.0">
                            <columnConstraints>
                                <ColumnConstraints minWidth="18.0" prefWidth="20.0" halignment="CENTER"/>
                                <ColumnConstraints hgrow="ALWAYS" minWidth="125.0"/>
                                <ColumnConstraints minWidth="42.0" prefWidth="46.0" halignment="RIGHT"/>
                            </columnConstraints>

                            <Label text="□" GridPane.columnIndex="0" GridPane.rowIndex="0" fx:id="acrobaticsProfMark"/><Label text="Acrobazia (Des)" GridPane.columnIndex="1" GridPane.rowIndex="0"/><Label text="+0" fx:id="acrobaticsBonusLabel" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                            <Label text="□" GridPane.columnIndex="0" GridPane.rowIndex="1" fx:id="animalHandlingProfMark"/><Label text="Addestrare Animali (Sag)" GridPane.columnIndex="1" GridPane.rowIndex="1"/><Label text="+0" fx:id="animalHandlingBonusLabel" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                            <Label text="□" GridPane.columnIndex="0" GridPane.rowIndex="2" fx:id="arcanaProfMark"/><Label text="Arcano (Int)" GridPane.columnIndex="1" GridPane.rowIndex="2"/><Label text="+0" fx:id="arcanaBonusLabel" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
                            <Label text="□" GridPane.columnIndex="0" GridPane.rowIndex="3" fx:id="athleticsProfMark"/><Label text="Atletica (For)" GridPane.columnIndex="1" GridPane.rowIndex="3"/><Label text="+0" fx:id="athleticsBonusLabel" GridPane.columnIndex="2" GridPane.rowIndex="3"/>
                            <Label text="□" GridPane.columnIndex="0" GridPane.rowIndex="4" fx:id="deceptionProfMark"/><Label text="Inganno (Car)" GridPane.columnIndex="1" GridPane.rowIndex="4"/><Label text="+0" fx:id="deceptionBonusLabel" GridPane.columnIndex="2" GridPane.rowIndex="4"/>
                            <Label text="□" GridPane.columnIndex="0" GridPane.rowIndex="5" fx:id="historyProfMark"/><Label text="Storia (Int)" GridPane.columnIndex="1" GridPane.rowIndex="5"/><Label text="+0" fx:id="historyBonusLabel" GridPane.columnIndex="2" GridPane.rowIndex="5"/>
                            <Label text="□" GridPane.columnIndex="0" GridPane.rowIndex="6" fx:id="insightProfMark"/><Label text="Intuizione (Sag)" GridPane.columnIndex="1" GridPane.rowIndex="6"/><Label text="+0" fx:id="insightBonusLabel" GridPane.columnIndex="2" GridPane.rowIndex="6"/>
                            <Label text="□" GridPane.columnIndex="0" GridPane.rowIndex="7" fx:id="intimidationProfMark"/><Label text="Intimidire (Car)" GridPane.columnIndex="1" GridPane.rowIndex="7"/><Label text="+0" fx:id="intimidationBonusLabel" GridPane.columnIndex="2" GridPane.rowIndex="7"/>
                            <Label text="□" GridPane.columnIndex="0" GridPane.rowIndex="8" fx:id="investigationProfMark"/><Label text="Investigazione (Int)" GridPane.columnIndex="1" GridPane.rowIndex="8"/><Label text="+0" fx:id="investigationBonusLabel" GridPane.columnIndex="2" GridPane.rowIndex="8"/>
                            <Label text="□" GridPane.columnIndex="0" GridPane.rowIndex="9" fx:id="medicineProfMark"/><Label text="Medicina (Sag)" GridPane.columnIndex="1" GridPane.rowIndex="9"/><Label text="+0" fx:id="medicineBonusLabel" GridPane.columnIndex="2" GridPane.rowIndex="9"/>
                            <Label text="□" GridPane.columnIndex="0" GridPane.rowIndex="10" fx:id="natureProfMark"/><Label text="Natura (Int)" GridPane.columnIndex="1" GridPane.rowIndex="10"/><Label text="+0" fx:id="natureBonusLabel" GridPane.columnIndex="2" GridPane.rowIndex="10"/>
                            <Label text="□" GridPane.columnIndex="0" GridPane.rowIndex="11" fx:id="perceptionProfMark"/><Label text="Percezione (Sag)" GridPane.columnIndex="1" GridPane.rowIndex="11"/><Label text="+0" fx:id="perceptionBonusLabel" GridPane.columnIndex="2" GridPane.rowIndex="11"/>
                            <Label text="□" GridPane.columnIndex="0" GridPane.rowIndex="12" fx:id="performanceProfMark"/><Label text="Intrattenere (Car)" GridPane.columnIndex="1" GridPane.rowIndex="12"/><Label text="+0" fx:id="performanceBonusLabel" GridPane.columnIndex="2" GridPane.rowIndex="12"/>
                            <Label text="□" GridPane.columnIndex="0" GridPane.rowIndex="13" fx:id="persuasionProfMark"/><Label text="Persuasione (Car)" GridPane.columnIndex="1" GridPane.rowIndex="13"/><Label text="+0" fx:id="persuasionBonusLabel" GridPane.columnIndex="2" GridPane.rowIndex="13"/>
                            <Label text="□" GridPane.columnIndex="0" GridPane.rowIndex="14" fx:id="religionProfMark"/><Label text="Religione (Int)" GridPane.columnIndex="1" GridPane.rowIndex="14"/><Label text="+0" fx:id="religionBonusLabel" GridPane.columnIndex="2" GridPane.rowIndex="14"/>
                            <Label text="□" GridPane.columnIndex="0" GridPane.rowIndex="15" fx:id="sleightOfHandProfMark"/><Label text="Rapidità di mano (Des)" GridPane.columnIndex="1" GridPane.rowIndex="15"/><Label text="+0" fx:id="sleightOfHandBonusLabel" GridPane.columnIndex="2" GridPane.rowIndex="15"/>
                            <Label text="□" GridPane.columnIndex="0" GridPane.rowIndex="16" fx:id="stealthProfMark"/><Label text="Furtività (Des)" GridPane.columnIndex="1" GridPane.rowIndex="16"/><Label text="+0" fx:id="stealthBonusLabel" GridPane.columnIndex="2" GridPane.rowIndex="16"/>
                            <Label text="□" GridPane.columnIndex="0" GridPane.rowIndex="17" fx:id="survivalProfMark"/><Label text="Sopravvivenza (Sag)" GridPane.columnIndex="1" GridPane.rowIndex="17"/><Label text="+0" fx:id="survivalBonusLabel" GridPane.columnIndex="2" GridPane.rowIndex="17"/>
                        </GridPane>

                        <Separator/>
                        <HBox spacing="8.0" alignment="CENTER_LEFT">
                            <Label text="PERCEZIONE PASSIVA" style="-fx-text-fill: #6d1f1f; -fx-font-size: 9px; -fx-font-weight: bold;"/>
                            <Label fx:id="passivePerceptionLabel" text="10" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                        </HBox>
                    </VBox>
                </VBox>

                <!-- ===================== CENTER COLUMN ===================== -->
                <VBox GridPane.columnIndex="1" GridPane.rowIndex="0" spacing="10.0">

                    <!-- Combat -->
                    <VBox spacing="9.0"
                          style="-fx-background-color: #f4efe4; -fx-border-color: #6d1f1f; -fx-border-width: 1.5; -fx-padding: 9 9 10 9;">
                        <Label text="COMBATTIMENTO"
                               style="-fx-background-color: #6d1f1f; -fx-text-fill: #f8f2e6; -fx-font-family: 'Georgia'; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 5 7 5 7;"/>

                        <HBox spacing="7.0" alignment="CENTER">
                            <VBox alignment="CENTER" minHeight="65.0" HBox.hgrow="ALWAYS" spacing="3.0"
                                  style="-fx-background-color: #ebe2d2; -fx-border-color: #8f7a62; -fx-border-width: 1; -fx-padding: 7;">
                                <Label text="CLASSE ARMATURA" wrapText="true" textAlignment="CENTER" style="-fx-text-fill: #6d1f1f; -fx-font-size: 9px; -fx-font-weight: bold;"/>
                                <Label fx:id="armorClassLabel" text="10" style="-fx-font-family: 'Georgia'; -fx-font-size: 22px; -fx-font-weight: bold;"/>
                            </VBox>
                            <VBox alignment="CENTER" minHeight="65.0" HBox.hgrow="ALWAYS" spacing="3.0"
                                  style="-fx-background-color: #ebe2d2; -fx-border-color: #8f7a62; -fx-border-width: 1; -fx-padding: 7;">
                                <Label text="INIZIATIVA" style="-fx-text-fill: #6d1f1f; -fx-font-size: 9px; -fx-font-weight: bold;"/>
                                <Label fx:id="initiativeLabel" text="+0" style="-fx-font-family: 'Georgia'; -fx-font-size: 22px; -fx-font-weight: bold;"/>
                            </VBox>
                            <VBox alignment="CENTER" minHeight="65.0" HBox.hgrow="ALWAYS" spacing="3.0"
                                  style="-fx-background-color: #ebe2d2; -fx-border-color: #8f7a62; -fx-border-width: 1; -fx-padding: 7;">
                                <Label text="VELOCITÀ" style="-fx-text-fill: #6d1f1f; -fx-font-size: 9px; -fx-font-weight: bold;"/>
                                <Label fx:id="speedLabel" text="9 m" style="-fx-font-family: 'Georgia'; -fx-font-size: 22px; -fx-font-weight: bold;"/>
                            </VBox>
                        </HBox>

                        <VBox alignment="CENTER" spacing="2.0" minHeight="70.0"
                              style="-fx-background-color: #eee6d7; -fx-border-color: #6d1f1f; -fx-border-width: 1.5; -fx-padding: 8;">
                            <Label text="PUNTI FERITA" style="-fx-text-fill: #6d1f1f; -fx-font-size: 10px; -fx-font-weight: bold;"/>
                            <HBox alignment="CENTER" spacing="5.0">
                                <Label fx:id="currentHpLabel" text="0" style="-fx-font-family: 'Georgia'; -fx-font-size: 25px; -fx-font-weight: bold;"/>
                                <Label fx:id="maxHpLabel" text="/ 0" style="-fx-font-size: 13px;"/>
                            </HBox>
                        </VBox>

                        <HBox spacing="7.0" alignment="CENTER">
                            <VBox alignment="CENTER" minHeight="54.0" HBox.hgrow="ALWAYS" spacing="2.0"
                                  style="-fx-background-color: #ebe2d2; -fx-border-color: #8f7a62; -fx-border-width: 1; -fx-padding: 5;">
                                <Label text="DADI VITA" style="-fx-text-fill: #6d1f1f; -fx-font-size: 8px; -fx-font-weight: bold;"/>
                                <Label fx:id="hitDiceLabel" text="—" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                            </VBox>
                            <VBox alignment="CENTER" minHeight="54.0" HBox.hgrow="ALWAYS" spacing="2.0"
                                  style="-fx-background-color: #ebe2d2; -fx-border-color: #8f7a62; -fx-border-width: 1; -fx-padding: 5;">
                                <Label text="TAGLIA" style="-fx-text-fill: #6d1f1f; -fx-font-size: 8px; -fx-font-weight: bold;"/>
                                <Label fx:id="sizeLabel" text="Media" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                            </VBox>
                            <VBox alignment="CENTER" minHeight="54.0" HBox.hgrow="ALWAYS" spacing="2.0"
                                  style="-fx-background-color: #ebe2d2; -fx-border-color: #8f7a62; -fx-border-width: 1; -fx-padding: 5;">
                                <Label text="BONUS PROF." style="-fx-text-fill: #6d1f1f; -fx-font-size: 8px; -fx-font-weight: bold;"/>
                                <Label fx:id="combatProficiencyBonusLabel" text="+2" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- Attacks -->
                    <VBox spacing="7.0"
                          style="-fx-background-color: #f4efe4; -fx-border-color: #6d1f1f; -fx-border-width: 1.5; -fx-padding: 9;">
                        <Label text="ATTACCHI"
                               style="-fx-background-color: #6d1f1f; -fx-text-fill: #f8f2e6; -fx-font-family: 'Georgia'; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 5 7 5 7;"/>
                        <TableView fx:id="attacksTable" prefHeight="180.0" minHeight="180.0"
                                   style="-fx-background-color: #f8f4eb; -fx-border-color: #a59178; -fx-border-width: 1;">
                                            <columns>
                                <TableColumn fx:id="attackNameColumn" text="NOME" prefWidth="130.0"/>
                                <TableColumn fx:id="attackBonusColumn" text="BONUS" prefWidth="60.0"/>
                                <TableColumn fx:id="attackDamageColumn" text="DANNO / TIPO" prefWidth="145.0"/>
                            </columns>
                            <placeholder><Label text="Nessun attacco disponibile" wrapText="true"/></placeholder>
                        </TableView>
                    </VBox>

                    <!-- Spells -->
                    <VBox spacing="7.0"
                          style="-fx-background-color: #f4efe4; -fx-border-color: #6d1f1f; -fx-border-width: 1.5; -fx-padding: 9;">
                        <HBox alignment="CENTER_LEFT" spacing="7.0">
                            <Label text="MAGIE"
                                   HBox.hgrow="ALWAYS"
                                   style="-fx-background-color: #6d1f1f; -fx-text-fill: #f8f2e6; -fx-font-family: 'Georgia'; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 5 7 5 7;"/>
                            <Label text="BONUS ATTACCO" style="-fx-text-fill: #6d1f1f; -fx-font-size: 8px; -fx-font-weight: bold;"/>
                            <Label fx:id="spellAttackBonusLabel" text="+0" style="-fx-font-size: 13px; -fx-font-weight: bold;"/>
                            <Label text="CD" style="-fx-text-fill: #6d1f1f; -fx-font-size: 8px; -fx-font-weight: bold;"/>
                            <Label fx:id="spellSaveDcLabel" text="10" style="-fx-font-size: 13px; -fx-font-weight: bold;"/>
                        </HBox>
                        <TableView fx:id="spellsTable" prefHeight="235.0" minHeight="235.0"
                                   style="-fx-background-color: #f8f4eb; -fx-border-color: #a59178; -fx-border-width: 1;">
                            <columns>
                                <TableColumn fx:id="spellNameColumn" text="MAGIA" prefWidth="105.0"/>
                                <TableColumn fx:id="spellLevelColumn" text="LIV." prefWidth="42.0"/>
                                <TableColumn fx:id="spellRitualColumn" text="R" prefWidth="30.0"/>
                                <TableColumn fx:id="spellDescriptionColumn" text="DESCRIZIONE" prefWidth="170.0"/>
                            </columns>
                            <placeholder><Label text="Nessuna magia disponibile" wrapText="true"/></placeholder>
                        </TableView>
                    </VBox>
                </VBox>

                <!-- ===================== RIGHT COLUMN ===================== -->
                <VBox GridPane.columnIndex="2" GridPane.rowIndex="0" spacing="10.0">

                    <!-- Classes -->
                    <VBox spacing="7.0"
                          style="-fx-background-color: #f4efe4; -fx-border-color: #6d1f1f; -fx-border-width: 1.5; -fx-padding: 9;">
                        <Label text="CLASSI E SOTTOCLASSI"
                               style="-fx-background-color: #6d1f1f; -fx-text-fill: #f8f2e6; -fx-font-family: 'Georgia'; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 5 7 5 7;"/>
                        <TableView fx:id="classesTable" prefHeight="160.0" minHeight="160.0"
                                   style="-fx-background-color: #f8f4eb; -fx-border-color: #a59178; -fx-border-width: 1;">
                            <columns>
                                <TableColumn fx:id="classNameColumn" text="CLASSE" prefWidth="150.0"/>
                                <TableColumn fx:id="subclassNameColumn" text="SOTTOCLASSE" prefWidth="165.0"/>
                                <TableColumn fx:id="classLevelColumn" text="LIV." prefWidth="50.0"/>
                            </columns>
                            <placeholder><Label text="Nessuna classe disponibile" wrapText="true"/></placeholder>
                        </TableView>
                    </VBox>

                    <!-- Traits -->
                    <VBox spacing="7.0"
                          style="-fx-background-color: #f4efe4; -fx-border-color: #6d1f1f; -fx-border-width: 1.5; -fx-padding: 9;">
                        <Label text="TRATTI DELLE CLASSI"
                               style="-fx-background-color: #6d1f1f; -fx-text-fill: #f8f2e6; -fx-font-family: 'Georgia'; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 5 7 5 7;"/>
                        <ListView fx:id="classTraitsList" prefHeight="245.0" minHeight="245.0"
                                  style="-fx-background-color: #f8f4eb; -fx-border-color: #a59178; -fx-border-width: 1;"/>
                    </VBox>

                    <!-- Resources -->
                    <VBox spacing="7.0"
                          style="-fx-background-color: #f4efe4; -fx-border-color: #6d1f1f; -fx-border-width: 1.5; -fx-padding: 9;">
                        <Label text="RISORSE DI CLASSE"
                               style="-fx-background-color: #6d1f1f; -fx-text-fill: #f8f2e6; -fx-font-family: 'Georgia'; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 5 7 5 7;"/>
                        <TableView fx:id="classResourcesTable" prefHeight="150.0" minHeight="150.0"
                                   style="-fx-background-color: #f8f4eb; -fx-border-color: #a59178; -fx-border-width: 1;">
                            <columns>
                                <TableColumn fx:id="resourceNameColumn" text="RISORSA" prefWidth="180.0"/>
                                <TableColumn fx:id="resourceRecoveryColumn" text="RECUPERO" prefWidth="115.0"/>
                            </columns>
                            <placeholder><Label text="Nessuna risorsa"/></placeholder>
                        </TableView>
                    </VBox>
                </VBox>

                <!-- ===================== BOTTOM ===================== -->
                <VBox GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.columnSpan="3" spacing="10.0">
                    <HBox spacing="10.0" alignment="TOP_LEFT">

                        <!-- Equipment -->
                        <VBox spacing="7.0" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: #f4efe4; -fx-border-color: #6d1f1f; -fx-border-width: 1.5; -fx-padding: 9;">
                            <Label text="EQUIPAGGIAMENTO"
                                   style="-fx-background-color: #6d1f1f; -fx-text-fill: #f8f2e6; -fx-font-family: 'Georgia'; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 5 7 5 7;"/>
                            <TableView fx:id="inventoryTable" prefHeight="195.0" minHeight="195.0"
                                       style="-fx-background-color: #f8f4eb; -fx-border-color: #a59178; -fx-border-width: 1;">
                                <columns>
                                    <TableColumn fx:id="itemNameColumn" text="OGGETTO" prefWidth="220.0"/>
                                    <TableColumn fx:id="itemQuantityColumn" text="QTÀ" prefWidth="55.0"/>
                                    <TableColumn fx:id="itemWeightColumn" text="PESO" prefWidth="70.0"/>
                                    <TableColumn fx:id="itemDescriptionColumn" text="DESCRIZIONE" prefWidth="300.0"/>
                                </columns>
                                <placeholder><Label text="Inventario vuoto"/></placeholder>
                            </TableView>
                        </VBox>

                        <!-- Character info -->
                        <VBox spacing="7.0" prefWidth="390.0"
                              style="-fx-background-color: #f4efe4; -fx-border-color: #6d1f1f; -fx-border-width: 1.5; -fx-padding: 9;">
                            <Label text="INFORMAZIONI PERSONAGGIO"
                                   style="-fx-background-color: #6d1f1f; -fx-text-fill: #f8f2e6; -fx-font-family: 'Georgia'; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 5 7 5 7;"/>
                            <GridPane hgap="8.0" vgap="7.0">
                                <columnConstraints>
                                    <ColumnConstraints minWidth="95.0" prefWidth="105.0"/>
                                    <ColumnConstraints hgrow="ALWAYS"/>
                                </columnConstraints>
                                <Label text="BACKGROUND" style="-fx-text-fill: #6d1f1f; -fx-font-size: 9px; -fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                                <Label fx:id="backgroundDescriptionLabel" text="—" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                                <Label text="RAZZA" style="-fx-text-fill: #6d1f1f; -fx-font-size: 9px; -fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                                <Label fx:id="raceDescriptionLabel" text="—" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                                <Label text="VELOCITÀ BASE" style="-fx-text-fill: #6d1f1f; -fx-font-size: 9px; -fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                                <Label fx:id="baseSpeedLabel" text="—" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                                <Label text="SCUROVISIONE" style="-fx-text-fill: #6d1f1f; -fx-font-size: 9px; -fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                                <Label fx:id="darkvisionLabel" text="—" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                            </GridPane>
                        </VBox>
                    </HBox>
                </VBox>

                <columnConstraints>
                    <ColumnConstraints percentWidth="25.0" minWidth="285.0" prefWidth="330.0"/>
                    <ColumnConstraints percentWidth="34.0" minWidth="385.0" prefWidth="450.0"/>
                    <ColumnConstraints percentWidth="41.0" minWidth="430.0" prefWidth="545.0"/>
                </columnConstraints>
                <rowConstraints>
                    <RowConstraints vgrow="NEVER"/>
                    <RowConstraints vgrow="NEVER"/>
                </rowConstraints>
            </GridPane>
        </VBox>
    </content>
</fx:root>
