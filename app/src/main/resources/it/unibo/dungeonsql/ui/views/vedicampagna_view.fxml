<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<fx:root type="VBox" spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0"/>
    </padding>

    <Label text="DungeonSQL - Campagna " fx:id="lblTitle" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

    <VBox spacing="5.0" maxWidth="400.0">
        <Label text="Master:"/>
        <TextField fx:id="txtMaster" editable="false"/>
    </VBox>

    <VBox fx:id="vbxPg" spacing="5.0" maxWidth="400.0">
        <Label text="Personaggi con cui partecipi:"/>
        <TextField fx:id="txtPg" editable="false"/>
    </VBox>

    <VBox spacing="5.0" maxWidth="400.0">
        <Label text="Descrizione:"/>
        <TextArea fx:id="txtDescrizione" editable="false" wrapText="true" prefRowCount="4"/>
    </VBox>

    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <Button text="Indietro" onAction="#handleIndietro" style="-fx-background-color: #7f8c8d; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15;"/>
        <Button text="Crea Campagna" onAction="#handleCreaCampagna" defaultButton="true" style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15;"/>
    </HBox>
</fx:root>