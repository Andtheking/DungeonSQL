<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<fx:root type="javafx.scene.control.ScrollPane" fitToWidth="true" style="-fx-background-color: transparent;"
         xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    
    <VBox spacing="15.0" prefWidth="650.0">
        <padding>
            <Insets top="30.0" right="30.0" bottom="30.0" left="30.0"/>
        </padding>

        <Label text="DungeonSQL - Creazione Personaggio" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

        <!-- Dati Base -->
        <TitledPane text="Dati Generali Scheda" expanded="true">
            <GridPane hgap="15" vgap="10">
                <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>

                <Label text="Nome PG:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <TextField fx:id="txtNomePersonaggio" promptText="Es. Gimli" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <Label text="Taglia:" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                <ComboBox fx:id="cmbTaglia" prefWidth="150" GridPane.columnIndex="3" GridPane.rowIndex="1"/>
            </GridPane>
        </TitledPane>

        <!-- Combattimento e Background -->
        <TitledPane text="Combattimento e Background" expanded="true">
            <GridPane hgap="15" vgap="10">
                <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>

                <Label text="Punti Vita (Max HP):" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <Spinner fx:id="spnHp" min="1" max="500" initialValue="10" editable="true" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <Label text="Classe Armatura:" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                <Spinner fx:id="spnCa" min="1" max="30" initialValue="10" editable="true" GridPane.columnIndex="3" GridPane.rowIndex="0"/>

                <Label text="Allineamento:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <TextField fx:id="txtAllineamento" promptText="Es. Caotico Buono" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <Label text="Razza/Fonte:" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                <TextField fx:id="txtFonNome" promptText="Es. Umano" GridPane.columnIndex="3" GridPane.rowIndex="1"/>

                <Label text="Background:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <TextField fx:id="txtAppNome" promptText="Es. Eroe Popolare" GridPane.columnIndex="1" GridPane.rowIndex="2" GridPane.columnSpan="3"/>
            </GridPane>
        </TitledPane>

        <!-- Classe, Statistica ed Equipaggiamento -->
        <TitledPane text="Classe, Statistica Primaria ed Equipaggiamento" expanded="true">
            <GridPane hgap="15" vgap="10">
                <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>

                <Label text="Punteggio Forza:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <Spinner fx:id="spnForza" min="1" max="30" initialValue="10" editable="true" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <CheckBox fx:id="chkCompetenzaForza" text="Competenza Salvezza" GridPane.columnIndex="2" GridPane.rowIndex="0" GridPane.columnSpan="2"/>

                <Label text="Nome Classe (Livello 1):" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <TextField fx:id="txtNomeClasse" promptText="Es. Guerriero" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <Label text="Oggetto Iniziale (ID):" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                <TextField fx:id="txtCodiceOggetto" promptText="Es. ITM-001" GridPane.columnIndex="3" GridPane.rowIndex="1"/>

                <Label text="Nome Capacità:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <TextField fx:id="txtNomeCapacita" promptText="Es. Attacco Extra" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                <Label text="Livello Capacità:" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
                <Spinner fx:id="spnLivelloCapacita" min="1" max="20" initialValue="1" editable="true" GridPane.columnIndex="3" GridPane.rowIndex="2"/>
            </GridPane>
        </TitledPane>

        <!-- Bottoni e Stato -->
        <HBox spacing="10.0" alignment="CENTER_RIGHT">
            <Button text="Annulla" onAction="#handleAnnulla" style="-fx-background-color: #7f8c8d; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15;"/>
            <Button text="Crea Personaggio" onAction="#handleCreaPersonaggio" defaultButton="true" style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15;"/>
        </HBox>

        <VBox alignment="CENTER" spacing="5.0">
            <Label fx:id="lblError" style="-fx-text-fill: #c0392b; -fx-font-weight: bold;" wrapText="true"/>
            <Label fx:id="lblSuccess" style="-fx-text-fill: #27ae60; -fx-font-weight: bold;" wrapText="true"/>
        </VBox>
    </VBox>
</fx:root>